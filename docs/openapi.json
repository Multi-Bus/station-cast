{
  "components": {
    "schemas": {
      "CongestionResponse": {
        "description": "Raw estimated wait for one stop at one hour.\n\nNo grade (여유/보통/혼잡/매우혼잡) field yet",
        "properties": {
          "estimated_wait": {
            "title": "Estimated Wait",
            "type": "number"
          },
          "hour": {
            "title": "Hour",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "stop_id": {
            "title": "Stop Id",
            "type": "integer"
          }
        },
        "required": [
          "stop_id",
          "name",
          "hour",
          "estimated_wait"
        ],
        "title": "CongestionResponse",
        "type": "object"
      },
      "CorridorResponse": {
        "properties": {
          "hour": {
            "title": "Hour",
            "type": "integer"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/CorridorStopSnapshot"
            },
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "hour",
          "stops"
        ],
        "title": "CorridorResponse",
        "type": "object"
      },
      "CorridorStopSnapshot": {
        "properties": {
          "estimated_wait": {
            "title": "Estimated Wait",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "stop_id": {
            "title": "Stop Id",
            "type": "integer"
          }
        },
        "required": [
          "stop_id",
          "name",
          "estimated_wait"
        ],
        "title": "CorridorStopSnapshot",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Stop": {
        "properties": {
          "ars_number": {
            "title": "Ars Number",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "stop_id": {
            "title": "Stop Id",
            "type": "integer"
          },
          "stop_type": {
            "title": "Stop Type",
            "type": "string"
          }
        },
        "required": [
          "stop_id",
          "name",
          "ars_number",
          "lat",
          "lon",
          "stop_type"
        ],
        "title": "Stop",
        "type": "object"
      },
      "StopsResponse": {
        "properties": {
          "stops": {
            "items": {
              "$ref": "#/components/schemas/Stop"
            },
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "stops"
        ],
        "title": "StopsResponse",
        "type": "object"
      },
      "TimelinePoint": {
        "properties": {
          "estimated_wait": {
            "title": "Estimated Wait",
            "type": "number"
          },
          "hour": {
            "title": "Hour",
            "type": "integer"
          }
        },
        "required": [
          "hour",
          "estimated_wait"
        ],
        "title": "TimelinePoint",
        "type": "object"
      },
      "TimelineResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "stop_id": {
            "title": "Stop Id",
            "type": "integer"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelinePoint"
            },
            "title": "Timeline",
            "type": "array"
          }
        },
        "required": [
          "stop_id",
          "name",
          "timeline"
        ],
        "title": "TimelineResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Station Cast API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/corridor": {
      "get": {
        "description": "Every stop's estimated wait at one hour (default: current hour).",
        "operationId": "get_corridor_corridor_get",
        "parameters": [
          {
            "in": "query",
            "name": "hour",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 23,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hour"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorridorResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Corridor"
      }
    },
    "/health": {
      "get": {
        "description": "Health check endpoint.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/stops": {
      "get": {
        "description": "List every stop in the corridor with display metadata.",
        "operationId": "list_stops_stops_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StopsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Stops"
      }
    },
    "/stops/{stop_id}/congestion": {
      "get": {
        "description": "Raw estimated wait for one stop at one hour (default: current hour).",
        "operationId": "get_congestion_stops__stop_id__congestion_get",
        "parameters": [
          {
            "in": "path",
            "name": "stop_id",
            "required": true,
            "schema": {
              "title": "Stop Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "hour",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 23,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hour"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CongestionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Congestion"
      }
    },
    "/stops/{stop_id}/timeline": {
      "get": {
        "description": "Full 24-hour estimated-wait curve for one stop.",
        "operationId": "get_timeline_stops__stop_id__timeline_get",
        "parameters": [
          {
            "in": "path",
            "name": "stop_id",
            "required": true,
            "schema": {
              "title": "Stop Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Timeline"
      }
    }
  }
}
